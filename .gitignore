# !02_RUNTIMES/.gitkeep
# 03_AI_TOOLS/*
# !03_AI_TOOLS/.gitkeep

# Sensitive Credentials / Configs
.env
.env.local
*.pem
*.key

# Temp files
*.tmp
*.log

# Auto-setup temp download folder
._tmp_downloads/
